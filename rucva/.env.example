# Get a key at https://console.anthropic.com/settings/keys
# Set this in Vercel's dashboard (Project Settings > Environment Variables),
# not in this file — .env is for local testing only and must never be committed.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — powers the Sourcing Assistant's Keepa price/BSR history lookup
# and the AI chat's lookup_keepa_product tool. Get a key at
# https://keepa.com/#!api — this is a SEPARATE paid subscription from Keepa
# Pro (the browser extension). Leave unset and both features just show a
# clear "not connected" message instead of failing silently.
KEEPA_API_KEY=your-keepa-api-key-here
