KEEPA_API_KEY=your_keepa_api_key_here
SELLERAMP_API_KEY=your_selleramp_api_key_here

# Chat agent — defaults target a local Ollama server (free, no key required,
# nothing leaves your machine). Point these at Groq/OpenAI/another
# OpenAI-compatible endpoint later if you want.
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_API_KEY=ollama
AGENT_MODEL=llama3.1

# Alternative: Ollama Cloud (ollama.com) — hosted, bigger models than most
# machines can run locally, free tier for light usage. Get a key at
# ollama.com/settings/keys. NOTE: your prompts (and any business numbers in
# them) leave your machine and go to Ollama's servers — local Ollama above
# does not do this. Uncomment and fill in to switch:
# AGENT_BASE_URL=https://ollama.com/v1
# AGENT_API_KEY=your_ollama_cloud_api_key_here
# AGENT_MODEL=gpt-oss:20b

# Google Drive/Docs/Sheets (backend/google_client.py + backend/google_auth_setup.py).
# These are FILE PATHS, not secrets — the files they point to live outside this
# repository (default: your home directory's ~/.config/amz-va/) and are never
# committed, logged, or printed. Only set these if you want the files somewhere
# other than the defaults shown below; leave commented out to use the defaults.
# GOOGLE_CLIENT_SECRET_PATH=~/.config/amz-va/google_client_secret.json
# GOOGLE_TOKEN_PATH=~/.config/amz-va/google_token.json
